[workspace]
resolver = "2"
members = [
    "crates/domain",
    "crates/storage",
    "crates/raw-store",
    "crates/search",
    "crates/identity-resolver",
    "crates/normalization",
    "crates/export",
    "crates/backup",
    "crates/knowledge",
    "crates/benchmarks",
    "crates/daemon",
    "crates/adapter-sdk",
    "crates/adapter-host",
    "crates/adapter-markdown",
    "crates/adapter-claude-code",
    "crates/adapter-zcode",
    "crates/adapter-cursor",
    "crates/adapter-minimax",
    "crates/adapter-codex",
    "crates/ops-metrics",
    "crates/audit",
    "crates/adapter-jsonl",
    "crates/cli",
]

[workspace.package]
version = "0.2.0"
edition = "2021"
rust-version = "1.88"
license = "MIT OR Apache-2.0"
repository = "https://github.com/example/conversation-hub"

[workspace.dependencies]
# 错误处理
thiserror = "1.0"
anyhow = "1.0"
# 序列化
serde = { version = "1", features = ["derive"] }
serde_json = "1"
# 时间
time = { version = "0.3", features = ["serde", "formatting", "parsing", "macros"] }
# ID 生成
uuid = { version = "1", features = ["v4", "serde"] }
# 哈希（内容寻址）
blake3 = "1"
# 压缩（Raw Store，plan §9.6 zstd）
zstd = "0.13"
# 加密（backup，plan §14.3 XChaCha20-Poly1305）
chacha20poly1305 = "0.10"
# 密码派生（backup：Argon2id + 随机盐，抗 GPU 离线穷举）
argon2 = { version = "0.5", features = ["std"] }
# 全文检索（plan §9.5 Tantivy）
tantivy = "0.22"
# 日志/追踪
tracing = "0.1"
tracing-subscriber = { version = "0.3", features = ["env-filter"] }
# 异步（MVP 同步即可，留接口）
tokio = { version = "1", features = ["full"] }
# 显式声明 lru 让 cargo 选 tantivy 0.22 兼容范围内的最新（0.16+），避开
# lru 0.12.5 的 RUSTSEC-2026-0002 / RUSTSEC-2026-0253 两个 unsound bug。
# 实际生效版本由 `cargo update -p lru --precise <ver>` 在 Cargo.lock 中固化。
lru = "0.16"

[profile.release]
opt-level = 3
lto = "thin"
codegen-units = 1

# ── 供应链 advisory 修复（cargo audit 0 warnings 目标）────────────────────
# tantivy 0.22 间接依赖 lru 0.12.5（含 RUSTSEC-2026-0002 stacked-borrows +
# RUSTSEC-2026-0253 use-after-free 两个 unsound bug），通过 [workspace.dependencies]
# 显式声明 lru 0.18.x 让 cargo 选最高满足版本；cargo update -p lru --precise 0.18.2
# 会触发 tantivy 0.22.x 也接受 lru 0.12-0.18 范围的最新版本。
